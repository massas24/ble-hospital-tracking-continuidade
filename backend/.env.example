# Endpoint do Mirth Connect para onde os eventos de mudança de sala são
# enviados. Aponta para o mock_mirth.py local durante testes fora da rede
# do hospital (ex: http://127.0.0.1:6670).
MIRTH_URL=http://localhost:6661

# Margem (dBm) que uma sala nova tem de superar sobre a sala atual para a
# mudança ser aceite pela histerese ao vivo (a que gera os eventos de Mirth).
HYSTERESIS_MARGIN=5

# Nº de deteções recentes usadas na mediana de RSSI, no cálculo do
# location_status ao vivo (mesmo default do --median-window offline).
MEDIAN_WINDOW=5

# Nº de leituras seguidas iguais necessárias para a persistência confirmar
# uma sala, no cálculo do location_status ao vivo
PERSISTENCE_STREAK=3

# Quantas raw_detections recentes por MAC alimentam o recálculo da cadeia
# mediana+histerese+persistência a cada deteção nova, para o location_status.
LOCATION_STATUS_HISTORY_SIZE=30

# Segundos sem deteção até um beacon whitelisted passar a
# location_status: "desconhecida" (calculado em tempo de leitura).
INACTIVE_TIMEOUT_SEC=60

# Limiar mínimo de RSSI (dBm) - leituras mais fracas são ignoradas só pela
# camada de decisão do location_status (nunca pela histerese ao vivo nem
# pelo raw_detections, que ficam sempre completos). Vazio = desativado
# (default).
MIN_RSSI=

# Configuração de aquisição por omissão (guião secção 7) que um nó recebe de
# GET /api/node-config quando não tem override próprio em /api/esp-mapping -
# os mesmos valores que o firmware tinha compilados antes desta
# funcionalidade existir. Ver README, secção "Configuração remota do scan".
DEFAULT_SCAN_DURATION_SEC=5
DEFAULT_UPLOAD_INTERVAL_MS=10000
